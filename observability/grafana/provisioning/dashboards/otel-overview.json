    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (order_item) (rate(orders_created_total[1m]))",
          "legendFormat": "{{order_item}}",
          "refId": "A"
        }
      ],
      "title": "Orders created (rate/sec, by item)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le, payment_result) (rate(payment_processing_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95 {{payment_result}}",
          "refId": "A"
        }
      ],
      "title": "Payment processing duration (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "id": 3,
      "options": {"showTime": true, "wrapLogMessage": true},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service_name=~\"order-service|payment-service\"}",
          "refId": "A"
        }
      ],
      "title": "Logs (order + payment)",
      "type": "logs"
    }
  ],
